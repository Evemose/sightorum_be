### ============================================
### HYPERPARAMETER TUNING + TRAINING REQUESTS
### ============================================

### 19. Tune Logistic Regression Classifier
POST {{baseUrl}}/tune-and-train
Content-Type: application/json

{
  "request": {
    "model_type": "logistic_regression",
    "model_name": "yellow_taxi_logistic_tuned",
    "datasource": {
      "sql": "SELECT passenger_count, trip_distance, fare_amount, payment_type FROM yellow_tripdata_2015_01 WHERE payment_type IS NOT NULL LIMIT 5000",
      "bind_variables": {}
    },
    "target_column": "payment_type",
    "feature_columns": [
      "passenger_count",
      "fare_amount"
    ]
  },
  "param_space": {
    "C": {
      "type": "loguniform",
      "low": 0.001,
      "high": 10.0
    },
    "penalty": {
      "type": "categorical",
      "choices": [
        "l1",
        "l2",
        "elasticnet"
      ]
    },
    "solver": {
      "type": "categorical",
      "choices": [
        "lbfgs",
        "liblinear",
        "saga"
      ]
    },
    "max_iter": {
      "type": "int",
      "low": 100,
      "high": 2000
    }
  },
  "tuning_config": {
    "n_trials": 30,
    "max_tuning_time": 180,
    "metric": "f1_score"
  }
}

