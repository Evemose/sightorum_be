  },
  "target_column": "total_amount",
  "feature_columns": [
    "trip_miles",
    "passenger_count"
  ],
  "model_params": {
    "pre_period_end": 20,
    "post_period_start": 21,
    "alpha": 0.05
  }
}

### 18. Stability Selection (Regression)
# @timeout 1000 m
POST {{baseUrl}}/analysis/stability-selection
Content-Type: application/json

{
  "datasource": {
    "sql": "SELECT s.excursion_flag AS \"excursionFlag\", s.container_age_months AS \"containerAgeMonths\", s.container_insulation_type AS \"containerInsulationType\", s.vehicle_refrig_age_months AS \"vehicleRefrigAgeMonths\", s.vehicle_insulation_rating AS \"vehicleInsulationRating\", s.vehicle_reefer_kw_rated AS \"vehicleReeferKwRated\", s.vehicle_refrig_model AS \"vehicleRefrigModel\", s.vehicle_cargo_volume_m3 AS \"vehicleCargoVolumeM3\", s.ambient_temp_at_dispatch_c AS \"ambientTempAtDispatchC\", s.pre_departure_temp_c AS \"preDepartureTempC\", s.node_refrig_health_pct AS \"nodeRefrigHealthPct\", s.stop_sequence AS \"stopSequence\", s.route_total_stops AS \"routeTotalStops\", s.route_total_drive_hours AS \"routeTotalDriveHours\", s.pallet_position AS \"palletPosition\", s.product_mass_at_stop_kg AS \"productMassAtStopKg\", s.is_after_hours_arrival AS \"isAfterHoursArrival\", s.receiving_dock_temp_controlled AS \"receivingDockTempControlled\", s.receiving_delay_min AS \"receivingDelayMin\", s.product_class AS \"productClass\", s.site_type AS \"siteType\", s.is_hos_regulated AS \"isHosRegulated\", s.logger_months_since_cal AS \"loggerMonthsSinceCal\", c.\"door_A_m2\" AS \"doorAM2\", c.\"wall_A_m2\" AS \"wallAM2\", h.climate_zone AS \"climateZone\", n.has_redundancy AS \"nodeHasRedundancy\", n.refrig_system_type AS \"nodeRefrigSystemType\", n.refrig_system_age_months_at_start AS \"nodeRefrigSystemAge\" FROM cold_chain.shipments s LEFT JOIN cold_chain.containers c ON s.container_id = c.container_id LEFT JOIN cold_chain.hubs h ON s.hub_id = h.hub_id LEFT JOIN cold_chain.nodes n ON s.node_id = n.node_id",
    "bind_variables": {}
  },
  "control_features": [
    "preDepartureTempC",
    "ambientTempAtDispatchC",
    "vehicleRefrigModel",
    "climateZone",
    "siteType"
  ],
  "target_column": "excursionFlag",
  "feature_columns": [
    "containerAgeMonths",
    "containerInsulationType",
    "vehicleRefrigAgeMonths",
    "vehicleInsulationRating",
    "vehicleReeferKwRated",
    "vehicleCargoVolumeM3",
    "nodeRefrigHealthPct",
    "stopSequence",
    "routeTotalStops",
    "routeTotalDriveHours",
    "palletPosition",
    "productMassAtStopKg",
    "isAfterHoursArrival",
    "receivingDockTempControlled",
    "receivingDelayMin",
    "productClass",
    "isHosRegulated",
    "loggerMonthsSinceCal",
    "doorAM2",
    "wallAM2",
    "nodeHasRedundancy",
    "nodeRefrigSystemType",
    "nodeRefrigSystemAge"
  ],
  "problem_type": "classification",
  "bootstrap_runs": 50,
  "sample_fraction": 0.8,
  "correlation_threshold": 0.8,
  "selection_top_k": null,
  "random_state": 42
}

### 19. Stability Selection (Classification)
