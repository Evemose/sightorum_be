### 16. DoWhy
POST {{baseUrl}}/train
Content-Type: application/json

{
  "model_type": "dowhy",
  "model_name": "yellow_taxi_dowhy",
  "datasource": {
    "sql": "SELECT trip_miles, fare_amount, tip_amount, passenger_count, CASE WHEN payment_type = 1 THEN 1 ELSE 0 END AS card_payment FROM yts",
    "bind_variables": {}
  },
  "target_column": "tip_amount",
  "feature_columns": [
    "card_payment",
    "trip_miles",
    "fare_amount",
    "passenger_count"
  ],
  "model_params": {
    "treatment_column": "card_payment",
    "common_causes": [
      "trip_miles",
      "fare_amount",
      "passenger_count"
    ],
    "method_name": "backdoor.linear_regression",
    "control_value": 0,
    "treatment_value": 1
  }
}

