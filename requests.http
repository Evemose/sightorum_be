### Base URL
@baseUrl = http://localhost:8000
@databaseConnection = mydatabase.public.yellow_tripdata_2015_01

### ============================================
### CLASSIFICATION MODELS
### ============================================

### 1. Logistic Regression Classifier
POST {{baseUrl}}/train
Content-Type: application/json

{
  "model_type": "logistic_regression",
  "model_name": "yellow_taxi_logistic",
  "datasource": {
    "sql": "SELECT passenger_count, trip_distance, fare_amount, payment_type FROM yellow_tripdata_2015_01 WHERE payment_type IS NOT NULL LIMIT 5000",
    "bind_variables": {}
  },
  "target_column": "payment_type",
  "feature_columns": [
    "passenger_count",
    "fare_amount"
  ],
  "model_params": {
    "C": 1.0,
    "penalty": "l2",
    "solver": "lbfgs",
    "max_iter": 1000
  }
}

### 2. Random Forest Classifier
