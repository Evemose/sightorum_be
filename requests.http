      "type": "float",
      "low": 5.0,
      "high": 50.0
    },
    "learning_rate": {
      "type": "loguniform",
      "low": 10.0,
      "high": 1000.0
    },
    "n_iter": {
      "type": "int",
      "low": 250,
      "high": 2000
    },
    "init": {
      "type": "categorical",
      "choices": [
        "pca",
        "random"
      ]
    }
  },
