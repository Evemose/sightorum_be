### 30. Tune ARIMA (Time Series)
POST {{baseUrl}}/tune-and-train
Content-Type: application/json

{
  "request": {
    "model_type": "arima",
    "model_name": "yellow_taxi_arima_tuned",
    "datasource": {
      "sql": "SELECT fare_amount FROM yellow_tripdata_2015_01 WHERE fare_amount > 0 ORDER BY tpep_pickup_datetime LIMIT 500",
      "bind_variables": {}
    },
    "target_column": "fare_amount"
  },
  "param_space": {
    "order_p": {
      "type": "int",
      "low": 0,
      "high": 5
    },
    "order_d": {
      "type": "int",
      "low": 0,
      "high": 2
    },
    "order_q": {
      "type": "int",
      "low": 0,
      "high": 5
    },
    "trend": {
      "type": "categorical",
      "choices": [
        "n",
        "c",
        "t",
        "ct"
      ]
    }
  },
  "tuning_config": {
    "n_trials": 30,
    "max_tuning_time": 200,
    "metric": "auto"
  }
}

