### 16. Apriori
POST {{baseUrl}}/train
Content-Type: application/json

{
  "model_type": "apriori",
  "model_name": "yellow_taxi_apriori",
  "datasource": {
    "sql": "SELECT CONCAT( 'passengers_', CAST(passenger_count AS VARCHAR), ',',  'payment_', CAST(payment_type AS VARCHAR), ',',  'rate_', rate_code_id ) as items FROM yellow_tripdata_2015_01 WHERE passenger_count IS NOT NULL",
    "bind_variables": {}
  },
  "target_column": null,
  "feature_columns": [
    "items"
  ],
  "model_params": {
    "min_support": 0.1,
    "min_confidence": 0.5,
    "input_format": "transactions",
    "transaction_column": "items"
  }
}

