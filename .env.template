# RORM Spring AI Configuration Template
# Copy this file to .env and fill in your credentials

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI Model Configuration
# Default model is gpt-4o, can also use gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o

# Optional: OpenAI API Base URL (useful for Azure OpenAI or other compatible APIs)
# OPENAI_BASE_URL=https://api.openai.com

# Database Configuration (for demo)
# SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# RORM AI Configuration
# RORM_AI_INCLUDE_LOCATION_DETAILS=false
# RORM_AI_MAX_QUERY_RESULTS=100
