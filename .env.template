# RORM Spring AI Configuration Template
# Copy this file to .env and fill in your credentials

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI Model Configuration
# Default model is gpt-4o, can also use gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o

# Anthropic API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: OpenAI API Base URL (useful for Azure OpenAI or other compatible APIs)
# OPENAI_BASE_URL=https://api.openai.com

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here

# Valkey/Redis Password
VALKEY_PASSWORD=your-valkey-password-here

# PostgreSQL password used by the dev profile (application-dev.yaml)
POSTGRES_PASSWORD=your-postgres-password-here

# Hosts used by the dev profile (application-dev.yaml)
# DEV_HOST: server running Postgres, Valkey and Restate
# DEV_CALLBACK_HOST: address of this machine as reachable by Restate for SDK callbacks
DEV_HOST=your-dev-host-here
DEV_CALLBACK_HOST=your-callback-host-here
